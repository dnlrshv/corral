{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "corral-executor-brief-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "goal",
    "why",
    "sources",
    "acceptance",
    "commands",
    "constraints",
    "scope",
    "on_ambiguity"
  ],
  "properties": {
    "schema": {
      "const": "corral-executor-brief-v1"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "What to achieve, one or two sentences. Becomes the task objective."
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "description": "Why it matters; the context a reader cannot infer from the code."
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Issue, PR or document references, informational."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Authoritative inputs in priority order; the first entry wins a conflict. Newest decision wins over older text within the same entry.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Repository-relative, normalized, no '..'"
          },
          "role": {
            "enum": [
              "authoritative",
              "reference"
            ],
            "default": "authoritative"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "verify"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC[0-9]{1,3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "verify": {
            "type": "string",
            "minLength": 1,
            "description": "The id of a command in `commands` that demonstrates this criterion."
          },
          "test": {
            "type": "string",
            "description": "Test file or test id the executor adds or runs, when known."
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "default": ".",
            "description": "Repository-relative."
          },
          "where": {
            "type": "string",
            "default": "workspace",
            "description": "Where it runs, as text for the executor (for example 'workspace')."
          },
          "env": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Names of environment variables the command needs; values are never in a brief."
          },
          "evidence": {
            "type": "string",
            "description": "What counts as evidence beyond exit code and output tail, when the default is not enough."
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "reason"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "on_ambiguity": {
      "enum": [
        "stop-and-report"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "enum": [
            "corral-executor-result-v1"
          ]
        }
      }
    }
  }
}
