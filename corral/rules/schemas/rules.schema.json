{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "corral-rules-v1",
  "type": "object",
  "required": [
    "schema_version",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          },
          "applies_to": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repos": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tiers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "phases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "harnesses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
